node_modules/
# The bare form too: a SYMLINK named node_modules is not a directory, so the
# trailing-slash pattern misses it. A worktree agent committed its symlink,
# and checkout then clobbered the ignored real tree with it (2026-08-03).
node_modules
.expo/
.claude/
dist/
.DS_Store
artifacts/
supabase/.temp/
*.bak
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
.env
.env.local

# Test-harness build output — regenerated, never committed. The maintained
# test scripts run TypeScript directly via sucrase-node; this only appears if
# the legacy tsc compile is invoked manually.
.qa-compiled/

# Deterministic executable Bible-conformance reports (regenerated on demand).
test-results/bible-conformance/

# sweep runner output — measurements, not source
.sweep*/
.door/
