node_modules/
# The bare form too: a SYMLINK named node_modules is not a directory, so the
# trailing-slash pattern misses it. A worktree agent committed its symlink,
# and checkout then clobbered the ignored real tree with it (2026-08-03).
node_modules
.expo/
# .claude/ is LOCAL — settings, hooks wiring, caches — with ONE exception.
# `.claude/rules/` holds path-scoped LAWS, and a law only this machine can see
# is not a law: the concurrent agent in this shared checkout and any fresh clone
# must get them too. Written as `.claude/*` rather than `.claude/`, because git
# cannot re-include a path inside an EXCLUDED DIRECTORY — a bare
# `!.claude/rules/` under `.claude/` is silently powerless, verified here
# 2026-08-12 with `git check-ignore -v` before this line was written.
.claude/*
!.claude/rules/
dist/
.DS_Store
artifacts/
supabase/.temp/
*.bak
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
.env
.env.local

# Test-harness build output — regenerated, never committed. The maintained
# test scripts run TypeScript directly via sucrase-node; this only appears if
# the legacy tsc compile is invoked manually.
.qa-compiled/

# Deterministic executable Bible-conformance reports (regenerated on demand).
test-results/bible-conformance/

# sweep runner output — measurements, not source
.sweep*/
.door/
.bind/
.legv/
.legv-run.log

# parallel-gate runner output — measurements, not source
.bible-parallel/

